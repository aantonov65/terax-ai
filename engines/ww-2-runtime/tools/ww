cmd_plan() {
    if [ -z "$1" ]; then
        echo -e "${RED}Error: batch_id required${NC}" >&2
        echo "Usage: ww plan <batch_id> -p PRODUCT -f FORMAT -a ARCHETYPES --angles ANGLES -m MECHANISM [--hooks HOOKS] [--rb ROCK_BOTTOMS]" >&2
        exit 1
    fi

    "$PYTHON_BIN" "$SCRIPT_DIR/plan.py" "$@" --base-path "$BASE_PATH"
}

cmd_generate() {
    if [ -z "$1" ]; then
        echo -e "${RED}Error: task_id required${NC}" >&2
        echo "Usage: ww generate <task_id> [--output-dir <path>]" >&2
        exit 1
    fi

    "$PYTHON_BIN" "$SCRIPT_DIR/generate.py" "$@" --base-path "$BASE_PATH"
}

cmd_compile_spec() {
    if [ -z "$1" ]; then
        echo -e "${RED}Error: strategy JSON required${NC}" >&2
