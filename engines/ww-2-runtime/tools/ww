#!/usr/bin/env bash
#
# WW CLI - Entry point for ad generation operations
#
# Usage:
#   ww plan <batch_id> [options]        Generate batch spec from parameters
#   ww compile-angles <angles.md>       Compile strategist angles into product-scoped batch artifacts
#   ww rich-strategy <angle.md>         Compile detailed angle markdown into rich legacy strategy
#   ww product-package <bundle>         Generate production upstream package from source evidence
#   ww strategy build --product P ...   Build V4.1 strategy.json from strategy-plan YAML/JSON
#   ww compile-spec <strategy.json>     Compile strategist plan into canonical spec.json
#   ww lfs-brief <strategy.json>        Generate LFS per-task prompts from strategist brief
#   ww lfs-v4 <strategy.json>           Run full LFS V4 autopilot through final QA
#   ww lfs-v41 <strategy.json|dir>      Run V4.1 semantic-first autopilot beside V4
#   ww lfs-agent <angles.md|strategy.json> Guided LFS workflow with review pauses
#   ww research-cards <product>         Compile/verify product research cards
#   ww generate <task_id> [options]     Generate a single ad
#   ww batch <batch_id> [options]       Generate batch scripts once
#   ww video batch <batch_id> [options] Generate modular video component batch
#   ww storyboard <script|batch_id> [options] Generate visual storyboard from script
#   ww enrich <batch_id> [options]      Add visual briefs to generated scripts
#   ww upload <batch_id> [options]      Upload scripts to Google Docs + ClickUp
#   ww meta-upload <batch_id> [options] Upload creatives to META (copies x images)
#   ww perf-pull [options]             Pull read-only META performance insights
#   ww clarity-pull [options]           Pull Microsoft Clarity landing-page insights
#   ww status <batch_id>                Show batch status from report.json
#   ww validate <script_path> [options] Validate a generated script
#   ww imagebatch <batch_id> [options]   Generate ad images (character + text overlay)
#   ww headlines <product> <arc> <mech>  Generate ad headlines
#   ww copy <product> <arc> <mech>      Generate primary copy (above-image text)
#   ww animated <batch_id> [options]     Generate animated videos (or --full pipeline with QA + stitch)
#   ww broll --video <file> [options]     Add AI b-roll + captions to spokesperson video
#   ww visualize <script|--batch id>       Generate visual brief for editors (post-avatar)
#   ww avatar <batch_id> [options]         Generate avatar videos (WW-2 → WW-Ralph bridge)
#   ww qa <script|--batch batch_id>        Deterministic QA - format checks (hooks, CTA, product bridge)
#   ww qa-craft <script|--batch id>        LLM 7-dim craft audit (conversion leaks, belief gaps, advisory)
#   ww lfs-outline <batch_id>              Generate + contract-repair LFS outlines
#   ww lfs-chief <batch_id>                Copy-chief generated LFS scripts into output-chiefed/
#   ww lfs-semantic <batch_id>             Check script adherence to saved outlines
#   ww rank-combos <product|batch>         Rank modular component combos worst→best (Inceptly workflow)
#   ww preflight <batch_id> [options]     Pre-flight checklist before generation/upload
#   ww dashboard [--port N]              Open pipeline dashboard (default: localhost:8420)
#   ww scan [options]                    Scan META Ad Library for new creatives
#   ww research <product> [options]      Scrape Reddit + generate archetypes/hotwords
#   ww simulate <batch|script> [options]  Synthetic audience pre-test (archetype reactions)
#   ww products [--verbose] [--json]      Portfolio health check - all products at a glance
#   ww learn "<rule>"                    Add a quality gate from human correction
#   ww hire <subcommand> [options]       Upwork hiring automation (auth, post, search, invite, etc.)
#   ww lp-rip <URL> [options]            Rip a competitor landing page (capture + extract)
#   ww ad-scrape <URL|--query "brand">  Scrape META Ad Library (deep scroll, structured output)
#   ww tweet <URL> [--thread] [--save]  Read an X/Twitter post (uses FxTwitter, no auth)
#   ww x-signal [options]               Daily X timeline scan → signal digest (Scrapling + Nitter)
#   ww slides <product> "concept" -f X  Generate TikTok slideshow ad (6–10 slides, 9:16, fal)
#   ww transcribe <dir|file> [options]  Parallel transcribe videos (Boris pipeline)
#   ww help                             Show this help message
#

set -e

# Get the directory where this script lives
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_PATH="$(dirname "$SCRIPT_DIR")"
BASE_PATH="${WW_BASE_PATH:-$REPO_PATH}"
export PYTHONUNBUFFERED=1
if [ -n "${WW_PYTHON:-}" ]; then
    PYTHON_BIN="$WW_PYTHON"
elif [ -x "$REPO_PATH/.venv/bin/python" ]; then
    PYTHON_BIN="$REPO_PATH/.venv/bin/python"
else
    PYTHON_BIN="python3"
fi

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[0;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

show_help() {
    cat << 'EOF'
WW CLI - Ad Generation System

Usage:
  ww <command> [arguments] [options]

Commands:
  plan <batch_id>        Generate batch spec.json from parameters
    Options:
      -p, --product      Product code (NOOR, NRJNT, etc.) [required]
      -f, --format       Format (lfs, yapfest, rvsl) [required]
      -a, --archetypes   Comma-separated archetypes (ARC1,ARC2) [required]
      --angles           Comma-separated angles (A1B1,A2B3) [required]
      -m, --mechanism    Mechanism code (M1, M2) [required]
      --hooks            Comma-separated hooks (RAGE,THIRD) [lfs/yapfest]
      --rb               Comma-separated rock bottoms (RBPUB,RBREL) [lfs/yapfest]
      -v, --version      Version (default: V001)
      --dry-run          Preview task IDs without creating spec

  compile-angles <angles.md>    Compile strategist angles into product-scoped strategy/spec/artifacts
  rich-strategy <angle.md>      Compile detailed angle markdown into rich legacy strategy/spec
  product-package <bundle>      Generate config/research/angle/strategy artifacts from source evidence
  strategy build --product P    Build V4.1 strategy.json from strategy-plan YAML/JSON
  compile-spec <strategy.json>  Compile strategist plan into canonical spec.json
  lfs-brief <strategy.json>     Generate LFS per-task prompts from strategist brief
    Options:
      --batch-id ID      Override batch_id from strategy
      --workers N        Parallel Claude calls (default: 4)
      --force            Replace existing prompts/spec
      --dry-run          Validate planned work without API calls
      --max-attempts N   Generation + repair attempts per prompt

  lfs-v4 <strategy.json> Run full LFS V4 autopilot
    Runs: research-cards -> lfs-brief -> lfs-outline -> preflight ->
          batch --clean-output -> lfs-chief -> lfs-semantic -> lfs-finish
    Options:
      -w, --workers      Parallel workers for LLM repair/judge stages (default: 4)
      --generation-workers N  Parallel script generation workers (default: 20)
      --max-repair-rounds N   lfs-finish repair rounds (default: 4)
      --output-subdir DIR     Chiefed/final script directory (default: output-chiefed)
      --brief-model MODEL     Override LFS prompt-writing model
      --outline-model MODEL   Override outline-writing model
      --chief-model MODEL     Override copy-chief model
      --semantic-model MODEL  Override semantic judge/repair model

  lfs-v41 <strategy.json|dir> Run V4.1 semantic-first autopilot beside V4
    Runs: research-cards -> cached lfs-brief -> cached lfs-outline -> relaxed preflight ->
          batch --resume-missing -> output-v41 candidates -> objective finish ->
          semantic launchable -> final objective/semantic gate
    Folder mode runs many isolated strategy files in parallel. Outer jobs own
    parallelism; each child V4.1 run uses 1 inner worker to avoid nested API blasts.
    Options:
      --jobs N          Folder mode: isolated V4.1 child jobs (default: 20)
      -w, --workers      Parallel workers for LLM repair/judge stages (default: 4)
      --generation-workers N  Parallel script generation workers (default: 20)
      --objective-repair-rounds N  Objective hard-fact repair rounds (default: 1)
      --output-subdir DIR     V4.1 final script directory (default: output-v41)
      --brief-model MODEL     Override LFS prompt-writing model
      --outline-model MODEL   Override outline-writing model
      --semantic-model MODEL  Override semantic judge/repair model

  lfs-agent <angles.md|strategy.json> Guided terminal-first LFS V4.1 workflow
    Runs the V4.1 stages with durable state, artifact previews, and review
    pauses after each artifact-producing stage.
    Options:
      --resume BATCH_ID   Resume a held or partial guided run
      --from STAGE        Start from a specific stage
      --yolo              Run without review pauses
      -w, --workers       Parallel workers for LLM stages (default: 4)
      --generation-workers N  Parallel script generation workers (default: 20)

  research-cards <product> Compile/verify product-scoped research cards
    Options:
      --verify           Verify existing cards against legacy source sections
      --dry-run          Preview card creation without writing
      --force            Rewrite differing cards from source sections
