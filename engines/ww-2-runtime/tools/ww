cmd_lfs_brief() {
    if [ -z "$1" ]; then
        echo -e "${RED}Error: strategy JSON required${NC}" >&2
        echo "Usage: ww lfs-brief <strategy.json> [--workers N] [--force] [--dry-run] [--max-attempts N]" >&2
