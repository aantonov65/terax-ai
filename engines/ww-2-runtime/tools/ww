      --skip-frames      Reuse existing frames, generate videos only
      -a, --account      fal.ai account override (e.g., NOOR, NR)
      --full             Full pipeline: frames + videos + QA + retry + stitch
      --qa               Run QA on existing videos only (Whisper transcription check)
