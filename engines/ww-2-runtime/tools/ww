      --clean-output     Delete output/ before generating
      --resume-missing   Generate only task IDs with no existing output
      --append-version   Preserve existing output and add timestamped files

  video <subcommand>     Modular video engine (separate from LFS batch)
    Subcommands:
      batch <batch_id>       Write hooks/leads/bodies/ctas and assemble videos
      assemble <batch_id>    Assemble existing component libraries
      track <batch_id>       Build local tracking manifests from assembled output

  storyboard <script>         Generate visual storyboard from approved script
    Arguments:
      script             Script file path or task ID
    Options:
      --batch <id>       Brief all scripts in a batch
      --style "..."      Editing style note (e.g., "fast-cut UGC, handheld")
      -o, --output       Output file path
      -w, --workers      Parallel workers for batch mode (default: 5)

  enrich <batch_id>      Add visual briefs to generated scripts
    Options:
      -w, --workers      Max parallel workers (default: 10)
      -f, --force        Re-enrich even if already done
      --single <script>  Enrich a single script instead of batch
      --product <code>   Product code (for --single mode)

  upload <batch_id>      Upload scripts to Google Docs + ClickUp
    Options:
      --dry-run          Simulate without actual uploads
      --folder <id|url>  Google Drive folder (overrides upload-config.json)
      --no-color         Disable colored output
      --verbose          Enable verbose logging

  meta-upload <batch_id> Upload creatives to META (copies x images)
    Options:
      --dry-run          Simulate without actual uploads
      --ad-account       Override ad account ID (act_123456789)

  perf-pull              Pull read-only META performance insights
    Options:
      --product CODE     Product/client label and config folder (default: Sofyre)
      --ad-account ID    Account to read, with or without act_
      --date-preset P    today, yesterday, last_7d, last_30d, etc. (default: today)
      --since DATE       Start date YYYY-MM-DD; pair with --until
      --until DATE       End date YYYY-MM-DD; pair with --since
      --level LEVEL      account, campaign, adset, or ad (default: campaign)
      --list-accounts    List accounts visible to the token and exit

  clarity-pull           Pull Microsoft Clarity Data Export API live insights
    Options:
      --num-days N       Last 1, 2, or 3 days (default: 1)
      --dimension NAME   URL, Campaign, Source, Medium, Device, etc. Repeat up to 3
      --url-contains S   Post-filter rows for a landing page path/domain
      --product CODE     Label output files, e.g. FatOnFire

  status <batch_id>      Show batch status from report.json

  imagebatch <batch_id> [batch_id2 ...]  Generate ad images (one or multi-batch)
    Options:
      -w, --workers      Max parallel workers (default: 10)
      --rpm              API requests per minute limit (default: 18)
      --dry-run          Validate specs and write image-report.json without API calls

  headlines <script.md>                        Generate 2 fascination headlines for a script
  headlines --batch <BATCH_ID>                 All scripts in batch (parallel)
  headlines <product> <archetype> <mechanism>  Legacy: product-level headlines
    Options:
      -w, --workers      Parallel workers for batch mode (default: 10)
      -n, --count        Number of headlines (legacy mode, default: 20)
      -s, --save         Save to file (legacy mode)

  copy <product> <archetype> <mechanism>  Generate primary copy (above-image text)
    Arguments:
      product            Product code (NOOR, NRJNT, etc.)
      archetype          Archetype code (ARC1, ARC2, etc.)
      mechanism          Mechanism code (M1, M2, etc.)
    Options:
      -n, --count        Number of copy options (default: 10)
      -s, --save         Save to products/{product}/copy/

  animated-brief <product> "concept"  Generate 5-scene animated spec from rough idea
    Arguments:
      product            Product code (NOOR, NRJNT, etc.)
      concept            Your rough concept description
    Options:
      --arc              Narrative arc (villain, villain_first, before_after, trial,
