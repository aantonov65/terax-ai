        exit 1
    fi

    "$PYTHON_BIN" "$SCRIPT_DIR/compile_spec.py" "$@" --base-path "$BASE_PATH"
}

cmd_compile_angles() {
    if [ -z "$1" ]; then
        echo -e "${RED}Error: angles.md required${NC}" >&2
        echo "Usage: ww compile-angles products/PRODUCT/batches/BATCH/angles.md [--dry-run] [--force]" >&2
        exit 1
    fi

    "$PYTHON_BIN" "$SCRIPT_DIR/compile_angles.py" "$@" --base-path "$BASE_PATH"
}

cmd_rich_strategy() {
    if [ -z "$1" ]; then
        echo -e "${RED}Error: angle.md required${NC}" >&2
