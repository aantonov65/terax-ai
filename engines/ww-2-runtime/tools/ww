cmd_lfs_finish() {
    local batch_id="$1"
    if [ -z "$batch_id" ]; then
        echo -e "${RED}Error: batch_id required${NC}" >&2
        echo "Usage: ww lfs-finish <batch_id>" >&2
        echo "       Runs the full LFS QA chain: verify → fix → opener-check → opener-rewrite → final verify" >&2
        exit 1
    fi
    local batch_dir="$BASE_PATH/batches/$batch_id"
    if [ ! -d "$batch_dir" ]; then
        echo -e "${RED}Error: batch directory not found: $batch_dir${NC}" >&2
        echo "       Did you mean one of these?" >&2
        ls "$BASE_PATH/batches" 2>/dev/null | grep -i "$batch_id" | head -5 | sed 's/^/         /' >&2
        exit 1
    fi
    if [ ! -f "$batch_dir/spec.json" ]; then
        echo -e "${RED}Error: $batch_dir/spec.json missing${NC}" >&2
        echo "       LFS QA needs a spec.json with product + cta_text fields." >&2
        exit 1
    fi
    shift
    local output_subdir="output"
    while [ $# -gt 0 ]; do
        case "$1" in
            --output-subdir)
                output_subdir="$2"
                shift 2
                ;;
            *)
                echo -e "${RED}Error: unknown lfs-finish option: $1${NC}" >&2
                echo "Usage: ww lfs-finish <batch_id> [--output-subdir output-chiefed]" >&2
                exit 1
                ;;
        esac
    done
    if [ ! -d "$batch_dir/$output_subdir" ] || [ -z "$(ls -A "$batch_dir/$output_subdir" 2>/dev/null)" ]; then
        echo -e "${RED}Error: $batch_dir/$output_subdir is empty or missing${NC}" >&2
        echo "       Run \`ww batch $batch_id\` first, or choose the correct --output-subdir." >&2
        exit 1
    fi
    local verify_status=0
    local fix_status=0
    local opener_status=0
    local rewrite_status=0
    local final_verify_status=0
    local final_opener_status=0
    local max_repair_rounds="${LFS_FINISH_MAX_ROUNDS:-4}"
    local fix_rounds_run=0
    local opener_rounds_run=0

    echo -e "\n${YELLOW}=== [1/4] verify ===${NC}"
    set +e
    "$PYTHON_BIN" "$SCRIPT_DIR/lfs_verify.py" --batch "$batch_id" --compact --output-subdir "$output_subdir"
    verify_status=$?
    set -e
    if [ $verify_status -ne 0 ]; then
        echo -e "${YELLOW}  Initial verifier found issues — continuing to fix${NC}"
    fi

    final_verify_status=$verify_status
    local fix_round=1
    while [ $fix_round -le "$max_repair_rounds" ] && [ $final_verify_status -ne 0 ]; do
        echo -e "\n${YELLOW}=== [2/$max_repair_rounds] compliance-fix round $fix_round ===${NC}"
        set +e
        "$PYTHON_BIN" "$SCRIPT_DIR/lfs_fix.py" --batch "$batch_id" --max-passes 1 --output-subdir "$output_subdir"
        fix_status=$?
        "$PYTHON_BIN" "$SCRIPT_DIR/lfs_verify.py" --batch "$batch_id" --compact --output-subdir "$output_subdir"
        final_verify_status=$?
        set -e
        fix_rounds_run=$fix_round
        if [ $final_verify_status -eq 0 ]; then
            echo -e "${GREEN}  Compliance clean after round $fix_round${NC}"
            break
        fi
        echo -e "${YELLOW}  Compliance issues remain after round $fix_round${NC}"
        fix_round=$((fix_round + 1))
    done

    echo -e "\n${YELLOW}=== [3/5] opener-check ===${NC}"
    set +e
    "$PYTHON_BIN" "$SCRIPT_DIR/lfs_opener_check.py" --batch "$batch_id" --workers 6 --output-subdir "$output_subdir"
    opener_status=$?
    set -e
    final_opener_status=$opener_status
    local opener_round=1
    while [ $opener_round -le "$max_repair_rounds" ] && [ $final_opener_status -ne 0 ]; do
        echo -e "\n${YELLOW}=== [3b/$max_repair_rounds] opener-rewrite round $opener_round (FAILs only; PARTIALs keep edge) ===${NC}"
        set +e
        "$PYTHON_BIN" "$SCRIPT_DIR/lfs_opener_rewrite.py" --batch "$batch_id" --output-subdir "$output_subdir"
        rewrite_status=$?
        "$PYTHON_BIN" "$SCRIPT_DIR/lfs_opener_check.py" --batch "$batch_id" --workers 6 --output-subdir "$output_subdir"
        final_opener_status=$?
        set -e
        opener_rounds_run=$opener_round
        if [ $final_opener_status -eq 0 ]; then
            echo -e "${GREEN}  Openers clean after round $opener_round${NC}"
            break
        fi
        echo -e "${YELLOW}  Opener issues remain after round $opener_round${NC}"
        opener_round=$((opener_round + 1))
    done

    echo -e "\n${YELLOW}=== [4/5] final verify ===${NC}"
    set +e
    "$PYTHON_BIN" "$SCRIPT_DIR/lfs_verify.py" --batch "$batch_id" --compact --output-subdir "$output_subdir"
    final_verify_status=$?
    set -e

    echo -e "\n${YELLOW}=== [5/5] final opener-check ===${NC}"
    if [ $final_opener_status -eq 0 ]; then
        echo -e "${GREEN}  Openers already clean after repair loop${NC}"
    else
        set +e
        "$PYTHON_BIN" "$SCRIPT_DIR/lfs_opener_check.py" --batch "$batch_id" --workers 6 --output-subdir "$output_subdir"
        final_opener_status=$?
        set -e
    fi

    echo -e "\n${YELLOW}=== finish report ===${NC}"
    set +e
    "$PYTHON_BIN" "$SCRIPT_DIR/lfs_finish_report.py" \
        --batch "$batch_id" \
        --initial-verify "$verify_status" \
        --fix "$fix_status" \
        --initial-opener "$opener_status" \
        --rewrite "$rewrite_status" \
        --final-verify "$final_verify_status" \
        --final-opener "$final_opener_status" \
        --fix-rounds "$fix_rounds_run" \
        --opener-rounds "$opener_rounds_run" \
        --max-rounds "$max_repair_rounds" \
        --output-subdir "$output_subdir"
    report_status=$?
    set -e

    if [ $final_verify_status -ne 0 ] || [ $final_opener_status -ne 0 ] || [ $report_status -ne 0 ]; then
        echo -e "${RED}  LFS finish completed with remaining issues${NC}" >&2
        return 1
    fi
    echo -e "${GREEN}  LFS finish clean${NC}"
}

