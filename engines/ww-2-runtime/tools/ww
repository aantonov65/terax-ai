cmd_learn() {
    if [ -z "$1" ]; then
        echo -e "${RED}Error: rule text required${NC}" >&2
        echo "Usage: ww learn \"Product name must appear in script body\"" >&2
        exit 1
    fi

    local rule_text="$1"
    local agents_file="$BASE_PATH/AGENTS.md"
    local today=$(date +%Y-%m-%d)

    # Create a bead to track this correction
    local bd_output
    bd_output=$(bd create --title="QG: $rule_text" --description="Quality gate learned from human correction" --type=task --priority=2 2>&1)
    local bead_id
    bead_id=$(echo "$bd_output" | grep -o 'ww-2-[a-z0-9]*')

    if [ -z "$bead_id" ]; then
        echo -e "${RED}Error: Failed to create bead${NC}" >&2
        echo "$bd_output" >&2
        exit 1
    fi

    # Get next QG number from AGENTS.md
    local last_num
    last_num=$(grep -o 'QG-[0-9]*' "$agents_file" | sort -t- -k2 -n | tail -1 | grep -o '[0-9]*')
    if [ -z "$last_num" ]; then
        last_num=0
    fi
    local next_num=$(( 10#$last_num + 1 ))
    local gate_id=$(printf "QG-%03d" "$next_num")

    # Insert new gate row before the QUALITY_GATES_END marker
    local new_row="| $gate_id | $rule_text | $today | $bead_id |"
    # Use awk to insert before the end marker (sed chokes on pipe chars in table rows)
    awk -v row="$new_row" '/<!-- QUALITY_GATES_END -->/{print row}1' "$agents_file" > "$agents_file.tmp" && mv "$agents_file.tmp" "$agents_file"

    # Close the bead as applied
    bd close "$bead_id" --reason="Applied as $gate_id in AGENTS.md" > /dev/null 2>&1

    echo -e "${GREEN}Learned:${NC} $gate_id - $rule_text"
    echo -e "${BLUE}Bead:${NC} $bead_id (closed)"
    echo -e "${YELLOW}Next generation will pick this up automatically.${NC}"
}

cmd_status() {
    if [ -z "$1" ]; then
        echo -e "${RED}Error: batch_id required${NC}" >&2
        echo "Usage: ww status <batch_id>" >&2
        exit 1
    fi

    local batch_id="$1"
    local report_file
    set +e
    report_file=$(PYTHONPATH="$SCRIPT_DIR" "$PYTHON_BIN" << EOF
from pathlib import Path
from ww_paths import resolve_batch_dir
base = Path("$BASE_PATH")
batch = "$batch_id"
try:
    batch_dir = resolve_batch_dir(batch, base_path=base)
except Exception as exc:
    raise SystemExit(str(exc))
for name in ("lfs-v41-report.json", "image-report.json", "report.json"):
    path = batch_dir / name
    if path.exists():
        print(path)
        raise SystemExit(0)
raise SystemExit(f"No report found in {batch_dir}")
EOF
)
    local resolver_status=$?
    set -e

    if [ $resolver_status -ne 0 ] || [ ! -f "$report_file" ]; then
        echo -e "${RED}Error: No report found for batch '$batch_id'${NC}" >&2
        echo "$report_file" >&2
        exit 1
    fi

    # Parse and display report
    echo -e "${BLUE}Batch Status: $batch_id${NC}"
    echo "----------------------------------------"

    # Use Python to parse JSON and display nicely
    "$PYTHON_BIN" << EOF
import json
from pathlib import Path

report_file = Path("$report_file")
report = json.loads(report_file.read_text())

total = report.get("total_tasks", report.get("total", 0))
success = report.get("successful", report.get("generated", 0))
failed = report.get("failed", 0)
validated = report.get("validated")
schema = report.get("schema")

if schema:
    print(f"Schema:        {schema}")
print(f"Total tasks:   {total}")
print(f"Successful:    {success}")
print(f"Failed:        {failed}")
if validated is not None:
    print(f"Validated:     {validated}")

print()

# Show failed tasks if any
results = report.get("results", [])
failed_tasks = [r for r in results if not r.get("success")]
if failed_tasks:
    print("Failed tasks:")
    for t in failed_tasks:
        print(f"  ✗ {t.get('task_id')}")
        if t.get('error'):
            print(f"    Error: {t.get('error')}")

# Show validation failures if any
validation_results = report.get("validation_results", [])
if validation_results:
    failed_validations = [v for v in validation_results if not v.get("passed")]
    if failed_validations:
        print()
        print("Validation failures:")
        for v in failed_validations:
            print(f"  ✗ {v.get('task_id')}")
            errors = v.get('errors', [])
            for e in errors[:3]:  # Show first 3 errors
                print(f"    - {e}")
            if len(errors) > 3:
                print(f"    ... and {len(errors) - 3} more")
EOF
}

